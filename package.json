{
  "name": "@shadow-js/forms",
  "version": "1.0.2",
  "description": "Forms with fine-grained values, schema validation, field arrays and server errors",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/dev/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/prod/index.js"
    },
    "./server": {
      "types": "./dist/dev/server.d.ts",
      "development": "./dist/dev/server.js",
      "default": "./dist/prod/server.js"
    },
    "./arrays": {
      "types": "./dist/dev/arrays.d.ts",
      "development": "./dist/dev/arrays.js",
      "default": "./dist/prod/arrays.js"
    },
    "./async": {
      "types": "./dist/dev/async.d.ts",
      "development": "./dist/dev/async.js",
      "default": "./dist/prod/async.js"
    },
    "./submit-errors": {
      "types": "./dist/dev/submit-errors.d.ts",
      "development": "./dist/dev/submit-errors.js",
      "default": "./dist/prod/submit-errors.js"
    },
    "./standard-schema": {
      "types": "./dist/dev/standard-schema.d.ts",
      "development": "./dist/dev/standard-schema.js",
      "default": "./dist/prod/standard-schema.js"
    },
    "./dates": {
      "types": "./dist/dev/dates.d.ts",
      "development": "./dist/dev/dates.js",
      "default": "./dist/prod/dates.js"
    },
    "./full": {
      "types": "./dist/dev/full.d.ts",
      "development": "./dist/dev/full.js",
      "default": "./dist/prod/full.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run --project unit --project dom --project server",
    "test:gc": "vitest run --project gc --passWithNoTests",
    "test:perf": "vitest run --project perf --passWithNoTests",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm run test:perf && npm run test:gc"
  },
  "peerDependencies": {
    "@shadow-js/core": "^1.0.2",
    "@shadow-js/web": "^1.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@shadow-js/compiler": "^1.0.2",
    "@shadow-js/core": "^1.0.2",
    "@shadow-js/testing": "^1.0.2",
    "@shadow-js/web": "^1.0.2",
    "@types/node": "^24.0.0",
    "arktype": "2.2.8",
    "esbuild": "0.27.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.3",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "valibot": "1.5.0",
    "vitest": "5.0.3",
    "zod": "^4.6.5"
  },
  "homepage": "https://forms.shadowjs.net",
  "keywords": [
    "shadowjs",
    "forms"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadowjs-dev/forms.git"
  },
  "bugs": {
    "url": "https://github.com/shadowjs-dev/forms/issues"
  }
}
